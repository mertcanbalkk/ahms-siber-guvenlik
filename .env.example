# Yerel laboratuvar varsayılanları; npm start .env dosyasını okur.
KAFKA_BROKERS=127.0.0.1:29092
AI_URL=http://127.0.0.1:8000/predict
AI_TIMEOUT_MS=1500
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
KEY_REGISTRY_PATH=security/gateway-keys.json
STATE_PATH=data/gateway.sqlite
RAW_TOPIC=flight_telemetry_raw
VERIFIED_TOPIC=flight_telemetry_verified
QUARANTINE_TOPIC=flight_telemetry_quarantine
EVENT_TOPIC=security_events
MAX_AGE_MS=120000
MAX_FUTURE_MS=30000
CREATE_TOPICS=false
KAFKA_REQUIRE_MTLS=true
KAFKA_SSL_CA=security/tls/gateway/ca.pem
KAFKA_SSL_CERT=security/tls/gateway/cert.pem
KAFKA_SSL_KEY=security/tls/gateway/key.pem
# Python üreticisinde aynı yollar yerine security/tls/producer kimliğini kullanın.
