FROM python:3.12-slim-bookworm
WORKDIR /app
COPY requirements-lock.txt ./
RUN pip install --no-cache-dir -r requirements-lock.txt && useradd --create-home ahms
COPY ai_service.py train_model.py telemetry_producer.py kafka_security.py verified_reader.py ./
COPY tests ./tests
RUN python train_model.py && mkdir -p /app/data && chown -R ahms:ahms /app
USER ahms
CMD ["python", "-m", "uvicorn", "ai_service:app", "--host", "0.0.0.0", "--port", "8000"]
